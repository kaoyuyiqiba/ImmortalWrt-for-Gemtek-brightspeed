 static void airoha_pcie_phy_load_kflow(struct airoha_pcie_phy *pcie_phy)
 {
+	/* Retail 5.1.1.12, PCIe_G3_L0L1_init x2 branch, 0x36c440..0x36c4dc. */
+	if (pcie_phy->retail_rx_kflow) {
+		airoha_phy_pma0_set_bits(pcie_phy, REG_PCIE_PMA_RETAIL_RX_KFLOW,
+					 PCIE_RETAIL_RX_KFLOW_EN);
+		airoha_phy_pma1_set_bits(pcie_phy, REG_PCIE_PMA_RETAIL_RX_KFLOW,
+					 PCIE_RETAIL_RX_KFLOW_EN);
+		airoha_phy_pma0_clear_bits(pcie_phy, REG_PCIE_PMA_DIG_RESERVE_14,
+					   PCIE_FLL_LOAD_EN);
+		airoha_phy_pma1_clear_bits(pcie_phy, REG_PCIE_PMA_DIG_RESERVE_14,
+					   PCIE_FLL_LOAD_EN);
+	}
+
 	airoha_phy_pma0_update_field(pcie_phy, REG_PCIE_PMA_DIG_RESERVE_12,
 				     PCIE_FORCE_PMA_RX_SPEED, 0xa);
 	airoha_phy_pma1_update_field(pcie_phy, REG_PCIE_PMA_DIG_RESERVE_12,
@@ -1111,6 +1178,19 @@
 
 	airoha_phy_init_lane0_rx_fw_pre_calib(pcie_phy, PCIE_PORT_GEN2);
 	airoha_phy_init_lane1_rx_fw_pre_calib(pcie_phy, PCIE_PORT_GEN2);
+
+	/* Load the newly calibrated values before cycling CDR power. */
+	if (pcie_phy->retail_rx_kflow) {
+		airoha_phy_pma0_clear_bits(pcie_phy, REG_PCIE_PMA_DIG_RESERVE_14,
+					   PCIE_RETAIL_FLL_LATCH);
+		airoha_phy_pma1_clear_bits(pcie_phy, REG_PCIE_PMA_DIG_RESERVE_14,
+					   PCIE_RETAIL_FLL_LATCH);
+		usleep_range(10, 20);
+		airoha_phy_pma0_set_bits(pcie_phy, REG_PCIE_PMA_DIG_RESERVE_14,
+					 PCIE_RETAIL_FLL_LATCH);
+		airoha_phy_pma1_set_bits(pcie_phy, REG_PCIE_PMA_DIG_RESERVE_14,
+					 PCIE_RETAIL_FLL_LATCH);
+	}
 }
 
