#!/bin/sh /etc/rc.common
#
# Copyright (C) 2025 openwrt.org
#

START=99

. "$IPKG_INSTROOT/lib/functions.sh"

find_nct7802()
{
	for hwmon in /sys/class/hwmon/hwmon*; do
		if [ -f "$hwmon/name" ] && [ "$(cat "$hwmon/name" 2>/dev/null)" = "nct7802" ]; then
			echo "$hwmon"
			return
		fi
	done
	return 1
}

fan_write()
{
	if ! printf '%s\n' "$2" > "$hwmon/$1"; then
		printf '%s\n' 1 > "$hwmon/pwm1_enable"
		printf '%s\n' 255 > "$hwmon/pwm1"
		logger -t airoha_fan "Fan setup failed at $1; requested full speed"
		return 1
	fi
}

boot()
{
	case $(board_name) in
	gemtek,w1700k-ubi|\
	gemtek,xr1710g|\
	gemtek,xr1710g-ubi)
		# LuCI owns the persisted mode and curve when installed. Do not
		# overwrite its setup later in the same START=99 boot sequence.
		if [ -x /etc/init.d/fan ] && [ -s /etc/config/fan ]; then
			/etc/init.d/fan start
			return $?
		fi

		hwmon=$(find_nct7802) || {
			logger -t airoha_fan "NCT7802 not found; fan setup skipped"
			return 1
		}

		# Keep cooling active while configuring; fail to full speed on errors.
		fan_write pwm1_enable 1 && fan_write pwm1 255 || return 1

		# Existing OpenWrt PWM policy; retail uses separate local/PHY/Wi-Fi curves.
		fan_write pwm1_auto_point1_temp 40000 || return 1
		fan_write pwm1_auto_point2_temp 50000 || return 1
		fan_write pwm1_auto_point3_temp 60000 || return 1
		fan_write pwm1_auto_point4_temp 70000 || return 1
		fan_write pwm1_auto_point5_temp 80000 || return 1

		# Preserve the existing PWM duty points (not retail RPM targets).
		fan_write pwm1_auto_point1_pwm 54 || return 1
		fan_write pwm1_auto_point2_pwm 69 || return 1
		fan_write pwm1_auto_point3_pwm 95 || return 1
		fan_write pwm1_auto_point4_pwm 199 || return 1

		# Re-enable automatic fan control
		fan_write pwm1_enable 2 || return 1
		;;
	esac
}
